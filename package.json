{
  "name": "team-chat-task-app",
  "version": "1.0.0",
  "private": true,
  "description": "General-Purpose Team Chat and Task Management Application (TaskCom)",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @saas/api dev",
    "dev:web": "pnpm --filter @saas/web dev",
    "build": "pnpm --filter @saas/shared build && pnpm --parallel --filter \"./apps/*\" build",
    "test": "pnpm --filter @saas/api test && pnpm --filter @saas/web test",
    "seed": "pnpm --filter @saas/api seed",
    "lint": "pnpm --recursive lint"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
